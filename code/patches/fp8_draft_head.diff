+"""Draft-only quantized copy of the output projection for EAGLE/NEXTN drafters.
+
+SGLANG_DRAFT_LM_HEAD_QUANT=fp8 gives the draft model its own FP8 (E4M3, per-row scale)
+copy of its output head, run by the FP8 Marlin W8A16 kernel (BF16 activations, no
+activation quantization). The source weight is not modified: for tied Qwen3.5 MTP drafts
+it is the target's input embedding, which keeps serving the embedding lookup and the BF16
+target head. Only draft proposals change; the target still verifies every token.
+At batch 1 the projection streams the whole [vocab, hidden] matrix from DRAM, so halving
+its bytes roughly halves its time (measured 2.9 -> 1.5 ms for [248320, 2048] on SM120).
+"""
+
+import logging
+import os
+
+import torch
+
+from sglang.srt.layers.quantization.marlin_utils_fp8 import (
+    apply_fp8_marlin_linear,
+    prepare_fp8_layer_for_marlin,
+)
+
+logger = logging.getLogger(__name__)
+
+FP8_MAX = torch.finfo(torch.float8_e4m3fn).max
+
+
+def draft_lm_head_quant_mode():
+    return os.environ.get("SGLANG_DRAFT_LM_HEAD_QUANT", "").lower() or None
+
+
+class Fp8MarlinDraftHeadMethod:
+    def apply(self, layer, x, bias=None):
+        return apply_fp8_marlin_linear(
+            x, layer.weight, layer.weight_scale, layer.workspace,
+            layer.output_size_per_partition, layer.input_size_per_partition, bias,
+        )
+
+
+class Fp8MarlinDraftHead(torch.nn.Module):
+    def __init__(self, weight: torch.Tensor, chunk: int = 16384):
+        super().__init__()
+        n, k = weight.shape
+        q = torch.empty((n, k), dtype=torch.float8_e4m3fn, device=weight.device)
+        scale = torch.empty(n, dtype=torch.float32, device=weight.device)
+        with torch.no_grad():
+            for i in range(0, n, chunk):  # bounded temporaries: no full FP32 copy
+                blk = weight[i : i + chunk].float()
+                s = (blk.abs().amax(1) / FP8_MAX).clamp(min=1e-12)
+                q[i : i + chunk] = (blk / s[:, None]).to(torch.float8_e4m3fn)
+                scale[i : i + chunk] = s
+        self.weight = torch.nn.Parameter(q, requires_grad=False)
+        self.weight_scale = torch.nn.Parameter(scale, requires_grad=False)
+        self.output_size_per_partition, self.input_size_per_partition = n, k
+        self.orig_dtype, self.bias = weight.dtype, None
+        prepare_fp8_layer_for_marlin(self, size_k_first=False)
+        self.quant_method = Fp8MarlinDraftHeadMethod()
+
+
+class Int4MarlinDraftHeadMethod:
+    def apply(self, layer, x, bias=None):
+        from sgl_kernel.scalar_type import scalar_types
+
+        from sglang.srt.layers.quantization.marlin_utils import apply_gptq_marlin_linear
+
+        e = layer.empty_idx
+        return apply_gptq_marlin_linear(
+            x, layer.weight, layer.weight_scale, e, e, e, layer.workspace, scalar_types.uint4b8,
+            layer.output_size_per_partition, layer.input_size_per_partition, True, bias,
+        )
+
+
+class Int4MarlinDraftHead(torch.nn.Module):
+    """4-bit weight-only (symmetric RTN, per-group scales) copy on the GPTQ-Marlin W4A16 kernel."""
+
+    def __init__(self, weight: torch.Tensor, group_size: int = 32):
+        super().__init__()
+        from sgl_kernel.scalar_type import scalar_types
+
+        from sglang.srt.layers.quantization.marlin_utils import marlin_make_empty_g_idx, marlin_make_workspace
+        from sglang.test.test_marlin_utils import marlin_quantize
+
+        n, k = weight.shape
+        # pack in N chunks of whole 64-col Marlin tiles (bounded temporaries)
+        chunk = next(c for c in range(min(n, 32768) // 64 * 64, 0, -64) if n % c == 0)
+        qs, ss = [], []
+        with torch.no_grad():
+            for i in range(0, n, chunk):
+                _, q, s, *_ = marlin_quantize(weight[i : i + chunk].t().contiguous(), scalar_types.uint4b8,
+                                              group_size, False)
+                qs.append(q)
+                ss.append(s)
+        self.weight = torch.nn.Parameter(torch.cat(qs, 1), requires_grad=False)
+        self.weight_scale = torch.nn.Parameter(torch.cat(ss, 1), requires_grad=False)
+        self.empty_idx = marlin_make_empty_g_idx(weight.device)
+        self.workspace = marlin_make_workspace(weight.device)
+        self.output_size_per_partition, self.input_size_per_partition = n, k
+        self.quant_method = Int4MarlinDraftHeadMethod()
+
+
+class _SlicedHead(torch.nn.Module):
+    """BF16 hot-vocab rows of a tied head (the tied draft otherwise ignores the sliced head)."""
+
+    def __init__(self, weight):
+        super().__init__()
+        self.weight = torch.nn.Parameter(weight, requires_grad=False)
+
+
+class _QuantLinear(torch.nn.Module):
+    """nn.Linear stand-in running a quantized Marlin copy (x @ W.T)."""
+
+    def __init__(self, q):
+        super().__init__()
+        self.q = q
+
+    def forward(self, x):
+        return self.q.quant_method.apply(self.q, x)
+
+
+def maybe_quantize_draft_fc(draft_model) -> None:
+    """SGLANG_DRAFT_FC_QUANT=fp8|int4: weight-only copy of the MTP input projection (fc, a BF16
+    nn.Linear [hidden, 2*hidden] that the FP8 draft quantization skips; one cuBLAS GEMV per step)."""
+    mode = os.environ.get("SGLANG_DRAFT_FC_QUANT", "").lower()
+    if not mode:
+        return
+    for name, mod in list(draft_model.named_modules()):
+        if name.split(".")[-1] == "fc" and type(mod) is torch.nn.Linear and mod.bias is None:
+            w = mod.weight.data
+            q = Fp8MarlinDraftHead(w) if mode == "fp8" else Int4MarlinDraftHead(w)
+            parent = draft_model.get_submodule(name.rsplit(".", 1)[0]) if "." in name else draft_model
+            setattr(parent, name.split(".")[-1], _QuantLinear(q))
+            logger.info("Draft %s: %s Marlin copy of %s.", name, mode, tuple(w.shape))
+    torch.cuda.empty_cache()
+
+
+class ContextVocabHeadMethod:
+    def apply(self, layer, x, bias=None):
+        s = layer.static
+        static = s.quant_method.apply(s, x) if hasattr(s, "quant_method") else x @ s.weight.T
+        return torch.cat([static, (x @ layer.dyn_w.T) + layer.dyn_mask], dim=-1)
+
+
+class ContextVocabHead(torch.nn.Module):
+    """Static hot-vocab draft head + S dynamic BF16 rows holding the current request's prompt tokens
+    that the static map lacks (SGLANG_DRAFT_CONTEXT_VOCAB=S). Code copies identifiers from its
+    context; a draft that cannot emit them loses the round. Rows are refreshed at each prefill
+    (update(), outside CUDA graphs) in place, so captured graphs see them. Draft-only: the target
+    still verifies every token."""
+
+    def __init__(self, static, full_weight, hot_token_id, slots):
+        super().__init__()
+        self.static, self.full_weight, self.slots = static, full_weight, slots
+        self.weight = static.weight  # lets the logits processor dispatch to quant_method
+        self.k = hot_token_id.numel()
+        dev = full_weight.device
+        self.hot_ext = torch.cat([hot_token_id.to(dev), torch.zeros(slots, dtype=hot_token_id.dtype, device=dev)])
+        self.in_map = torch.zeros(full_weight.shape[0], dtype=torch.bool, device=dev)
+        self.in_map[hot_token_id.to(dev)] = True
+        self.neg = torch.finfo(full_weight.dtype).min
+        self.dyn_w = torch.zeros(slots, full_weight.shape[1], dtype=full_weight.dtype, device=dev)
+        self.dyn_mask = torch.full((slots,), self.neg, dtype=full_weight.dtype, device=dev)
+        self.quant_method = ContextVocabHeadMethod()
+
+    @torch.no_grad()
+    def update(self, input_ids: torch.Tensor) -> None:
+        ids = input_ids[(input_ids >= 0) & (input_ids < self.in_map.numel())]
+        new, cnt = torch.unique(ids[~self.in_map[ids]], return_counts=True)  # host sync: prefill only
+        if new.numel() > self.slots:
+            new = new[cnt.topk(self.slots).indices]
+        n = new.numel()
+        self.hot_ext[self.k : self.k + n] = new
+        self.dyn_w[:n] = self.full_weight.index_select(0, new)
+        self.dyn_mask[:n] = 0
+        self.dyn_mask[n:] = self.neg
+
+
+def maybe_quantize_draft_lm_head(draft_model, hot_token_id=None):
+    """Returns the hot-token id map the worker must use (extended when context rows are on)."""
+    mode = draft_lm_head_quant_mode()
+    if mode is None and hot_token_id is None:
+        return hot_token_id
+    if mode not in (None, "fp8", "int4"):
+        raise ValueError(f"SGLANG_DRAFT_LM_HEAD_QUANT={mode!r}: only 'fp8' or 'int4' are supported")
+    head = getattr(draft_model, "lm_head", None)
+    weight = getattr(head, "weight", None)
+    if weight is None or weight.dtype not in (torch.bfloat16, torch.float16) or weight.dim() != 2:
+        raise ValueError(f"draft lm_head is not a BF16/FP16 matrix ({type(head).__name__}); cannot quantize")
+    full_weight = weight
+    if hot_token_id is not None and weight.shape[0] != hot_token_id.numel():
+        # Tied Qwen3.5 MTP keeps the full embedding as its head: take the hot rows here so the
+        # draft's logits match hot_token_id (which maps draft top-k back to vocabulary ids).
+        weight = weight.index_select(0, hot_token_id.to(weight.device))
+    before = torch.cuda.memory_allocated()
+    if mode is None:
+        draft_model.lm_head = _SlicedHead(weight)
+        logger.info("Draft lm_head: BF16 hot-vocab rows %s (token map).", tuple(weight.shape))
+    else:
+        draft_model.lm_head = Fp8MarlinDraftHead(weight) if mode == "fp8" else Int4MarlinDraftHead(weight)
+        torch.cuda.empty_cache()  # release quantization temporaries before CUDA-graph capture
+        logger.info(
+            "Draft lm_head: %s Marlin copy of %s (%s), +%.0f MiB; source weight unchanged.",
+            "FP8 W8A16" if mode == "fp8" else "INT4 W4A16 g32", tuple(weight.shape), weight.dtype,
+            (torch.cuda.memory_allocated() - before) / 2**20,
+        )
+    slots = int(os.environ.get("SGLANG_DRAFT_CONTEXT_VOCAB", "0"))
+    if slots > 0 and hot_token_id is not None and full_weight.shape[0] > hot_token_id.numel():
+        draft_model.lm_head = ContextVocabHead(draft_model.lm_head, full_weight, hot_token_id, slots)
+        logger.info("Draft lm_head: + %d context rows (prompt tokens outside the hot map).", slots)
+        return draft_model.lm_head.hot_ext
+    return hot_token_id
